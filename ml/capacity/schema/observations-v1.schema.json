{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capacity observation v1",
  "description": "One timestamp-aligned Member 3 capacity observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "workload",
    "requests_per_second",
    "cpu_utilization_ratio",
    "memory_working_set_bytes",
    "p95_latency_seconds",
    "error_ratio",
    "replicas",
    "scaling_event",
    "scenario",
    "collection_interval_seconds",
    "data_source",
    "run_status"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time", "description": "RFC3339 UTC" },
    "workload": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "requests_per_second": { "type": "number", "minimum": 0 },
    "cpu_utilization_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "memory_working_set_bytes": { "type": "number", "minimum": 0 },
    "p95_latency_seconds": { "type": "number", "minimum": 0, "maximum": 120 },
    "error_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "replicas": { "type": "integer", "minimum": 1 },
    "scaling_event": { "enum": ["none", "scale_up", "scale_down", "pod_replacement"] },
    "scenario": { "enum": ["normal", "progressive", "spike", "sustained", "recovery"] },
    "collection_interval_seconds": { "type": "integer", "minimum": 1 },
    "data_source": { "type": "string", "minLength": 1 },
    "run_status": { "enum": ["passed", "failed"] }
  }
}
